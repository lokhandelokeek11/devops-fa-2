# Supabase deploy. Copy to terraform.tfvars and fill in the URI.
# Do not commit terraform.tfvars.
use_in_cluster_database = false
database_url            = "postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"
database_ssl            = "true"

# Self-contained Minikube deploy, including the CI pipeline:
# use_in_cluster_database = true
